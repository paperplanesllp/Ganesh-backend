NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ganesh-pickles
ADMIN_ACCOUNTS_JSON=[{"fullName":"Admin One","email":"admin1@example.com","phone":"9876543210","password":"replace-with-a-strong-password"}]

FRONTEND_URL=http://localhost:5173

# PhonePe Standard Checkout (leave credentials empty until issued by PhonePe)
PHONEPE_ENABLED=false
PHONEPE_ENV=SANDBOX
PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
