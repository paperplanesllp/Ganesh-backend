NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ganesh-pickles


FRONTEND_URL=http://localhost:5173
# Render production: set this to the exact deployed frontend origin, for example:
# FRONTEND_URL=https://www.ganeshpickles.com
# Optional comma-separated additions to the built-in production/local CORS allowlist.
CORS_ALLOWED_ORIGINS=

# PhonePe Standard Checkout (leave credentials empty until issued by PhonePe)
PHONEPE_ENV=PRODUCTION
PHONEPE_ENABLED=true
# Optional for SDK authentication; used only to validate merchant IDs when PhonePe returns one.
PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_DAYS=7

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=ganesh-pickles/products

# Order emails (customer confirmation + store-owner notification).
# Sent through an HTTPS email API because Render's free plan blocks SMTP ports.
# EMAIL_PROVIDER: resend or brevo. Set only the API key for the provider you use.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
# Sender address. Resend: must be on a domain verified in Resend.
# Brevo: must be a verified sender or on a verified domain in Brevo.
MAIL_FROM_EMAIL=orders@ganeshpickles.com
MAIL_FROM_NAME=Ganesh Pickles
# Who gets the "new order" email. Comma-separate for more than one address.
STORE_EMAIL=owner@example.com
# Where customer replies go (defaults to the first STORE_EMAIL address).
MAIL_REPLY_TO=
EMAIL_TIME_ZONE=Asia/Kolkata
