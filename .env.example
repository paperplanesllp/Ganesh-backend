NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ganesh-pickles


FRONTEND_URL=http://localhost:5173
# Render production: set this to the exact deployed frontend origin, for example:
# FRONTEND_URL=https://www.ganeshpickles.com
# Optional comma-separated additions to the built-in production/local CORS allowlist.
CORS_ALLOWED_ORIGINS=

# PhonePe Standard Checkout (leave credentials empty until issued by PhonePe)
PHONEPE_ENABLED=false
PHONEPE_ENV=SANDBOX
PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_DAYS=7

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=ganesh-pickles/products
